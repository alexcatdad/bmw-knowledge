# Copy to .env.local and retain the deployment selected by your Convex setup.
# .env.local is ignored; never put credentials in this example or a commit.
CONVEX_DEPLOYMENT=dev:your-personal-development-deployment

# Maintainer approval lives on the Convex deployment, not in discovery input.
# The developer CLI can install a reviewed JSON file with `approval set`.
# Limits also live on the Convex deployment (defaults: 524288 bytes / 15000 ms).
# Set them with explicit-dev `pnpm exec convex env set`, then `collection config`.

# Dedicated MinIO application identity. Do not use workflow-dev or root credentials.
# The worker's machine must have a tested route to the private endpoint.
S3_ENDPOINT=http://minio.home.lab:9000
S3_BUCKET=bmw-kb-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# A fine-grained token scoped to this corpus repository, Contents: read/write.
# Keep it on the worker; it is not a research-client credential.
CORPUS_GITHUB_OWNER=alexcatdad
CORPUS_GITHUB_REPO=bmw-corpus
CORPUS_GITHUB_BRANCH=main
CORPUS_GITHUB_TOKEN=

# Optional narrow processing callback. Set the same dedicated machine secret in
# the identified Convex deployment and corpus CI. This is not a GitHub token.
# Leave absent until the workflow is enabled; never share it with research clients.
PROCESSING_CALLBACK_URL=https://your-personal-development-deployment.convex.site/processing/result
PROCESSING_CALLBACK_SECRET=
